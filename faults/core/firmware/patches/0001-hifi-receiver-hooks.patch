 #endif    
-}
\ No newline at end of file
+}
+
+/****************************************************************************************
+ * equalizer, then the hifi-receiver power governor on the equalized samples
+ */
+void equalizer_process(uint8_t *buf, uint32_t bytes) {
+	equalizer_apply(buf, bytes);
+	if (hifi_dsp_process) hifi_dsp_process(buf, bytes / BYTES_PER_FRAME, BYTES_PER_FRAME, equalizer.samplerate);
+}
