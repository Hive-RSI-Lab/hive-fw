+extern void hifi_dsp_process(uint8_t *buf, uint32_t frames, int bytes_per_frame, uint32_t rate) __attribute__((weak));
+
+static void equalizer_apply(uint8_t *buf, uint32_t bytes) {
 #if BYTES_PER_FRAME == 4    
