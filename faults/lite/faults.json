     "replace": "{\\\"gpio\\\":19,"
    }
   ]
  },
  {
   "id": "led-on-open-pad",
   "expect": "PIN-NET",
   "about": "the LED on GPIO2, a pad the board leaves open",
   "edits": [
    {
     "file": "firmware/patches/0001-hifi-receiver-hooks.patch",
     "find": "\"14=ir:nec,22=green:1\" if HIFI_LITE",
     "replace": "\"14=ir:nec,2=green:1\" if HIFI_LITE"
