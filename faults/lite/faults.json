   ]
  },
  {
   "id": "board-dout-lrck-swapped",
   "expect": "PIN-NET",
   "about": "the board swaps I2S DOUT and LRCK at the module (a board fault the firmware meets)",
   "edits": [
    {
     "file": "boards/lite-main/kicad/lite-main.net",
     "find": "\"IO26_11\"",
     "replace": "\"SWAP\""
    },
    {
     "file": "boards/lite-main/kicad/lite-main.net",
     "find": "\"IO25_10\"",
     "replace": "\"IO26_11\""
    },
    {
     "file": "boards/lite-main/kicad/lite-main.net",
     "find": "\"SWAP\"",
     "replace": "\"IO25_10\""
    }
   ]
  },
  {
   "id": "ota1-overlaps-settings",
   "expect": "PART-OVERLAP",
   "about": "ota_1 grown into the settings partition",
   "edits": [
    {
     "file": "firmware/board/lite-main/partitions.csv",
