   "edits": [
    {
     "file": "firmware/board/lite-main/sdkconfig.defaults",
     "find": "CONFIG_ESPTOOLPY_FLASHSIZE=\"8MB\"",
     "replace": "CONFIG_ESPTOOLPY_FLASHSIZE=\"4MB\""
    }
   ]
  },
  {
   "id": "ota0-misaligned",
   "expect": "PART-ALIGN",
   "about": "ota_0 at an offset not on a 64 KB boundary",
   "edits": [
    {
     "file": "firmware/board/lite-main/partitions.csv",
     "find": "ota_0,    app,  ota_0,   0x1D0000, 0x310000,",
     "replace": "ota_0,    app,  ota_0,   0x1D8000, 0x308000,"
    }
   ]
  },
  {
   "id": "image-over-slot",
   "expect": "PART-IMAGE",
   "about": "ota_0 shrunk under the 2.77 MB main app",
   "edits": [
    {
     "file": "firmware/board/lite-main/partitions.csv",
     "find": "ota_0,    app,  ota_0,   0x1D0000, 0x310000,",
     "replace": "ota_0,    app,  ota_0,   0x1D0000, 0x2A0000,"
    }
   ]
  },
  {
   "id": "no-otadata",
   "expect": "PART-OTA",
   "about": "two OTA slots and no otadata",
   "edits": [
    {
     "file": "firmware/board/lite-main/partitions.csv",
     "find": "otadata,  data, ota,     0xD000,   0x2000,\n",
     "replace": ""
    }
   ]
  },
  {
   "id": "nvs-over-table",
   "expect": "PART-OVERLAP",
   "about": "nvs moved onto the partition table",
   "edits": [
    {
     "file": "firmware/board/lite-main/partitions.csv",
