{
 "about": "Planted faults on a copy of the hifi receiver's Lite firmware and board (hifi-receiver-2 main a7f32da). Each edit's find must occur exactly once; expect is the check meant to catch it.",
 "faults": [
  {
   "id": "amp-sdz-wrong-gpio",
   "expect": "PIN-NET",
   "about": "the amp's shutdown on GPIO22, where the board has the LED",
   "edits": [
    {
     "file": "firmware/components/hifi/esp/hifi_board_lite.h",
     "find": "#define PIN_AMP_SDZ 21",
     "replace": "#define PIN_AMP_SDZ 22"
    }
   ]
  },
  {
   "id": "i2s-bck-ws-swapped",
   "expect": "PIN-NET",
   "about": "I2S bit clock and word select swapped in the DAC config",
   "edits": [
    {
     "file": "firmware/patches/0001-hifi-receiver-hooks.patch",
     "find": "bck=27,ws=25,do=26,di=35,sda=33,scl=32,i2c=16,mck=0\" if HIFI_LITE",
     "replace": "bck=25,ws=27,do=26,di=35,sda=33,scl=32,i2c=16,mck=0\" if HIFI_LITE"
    }
   ]
  },
  {
   "id": "pvdd-en-unconnected",
   "expect": "PIN-NET",
   "about": "the PVDD switch driven on GPIO5, a pad the board leaves open",
   "edits": [
    {
     "file": "firmware/components/hifi/esp/hifi_board_lite.h",
     "find": "#define PIN_PVDD_EN 18",
     "replace": "#define PIN_PVDD_EN 5"
    }
   ]
  },
  {
   "id": "i2c-sda-on-flash",
   "expect": "PIN-FLASH",
   "about": "I2C SDA on GPIO7, the module's flash data line",
   "edits": [
    {
     "file": "firmware/components/hifi/esp/hifi_board_lite.h",
     "find": "#define I2C_SDA 33",
     "replace": "#define I2C_SDA 7"
    }
   ]
  },
  {
   "id": "pd-pg-on-psram",
   "expect": "PIN-FLASH",
   "about": "the PD good input on GPIO16, the WROVER's PSRAM chip select",
   "edits": [
    {
     "file": "firmware/components/hifi/esp/hifi_board_lite.h",
     "find": "#define PIN_PD_PG 4",
     "replace": "#define PIN_PD_PG 16"
    }
   ]
  },
  {
   "id": "pvdd-en-on-input-only",
   "expect": "PIN-INPUT",
   "about": "the PVDD enable output on GPIO39 (the PVDD sense net, input only)",
   "edits": [
    {
     "file": "firmware/components/hifi/esp/hifi_board_lite.h",
     "find": "#define PIN_PVDD_EN 18",
     "replace": "#define PIN_PVDD_EN 39"
    }
   ]
  },
  {
   "id": "amp-sdz-on-strap12",
   "expect": "STRAP-12",
   "about": "the amp's shutdown moved to GPIO12 on board and firmware alike: a strap pin",
   "edits": [
    {
     "file": "firmware/components/hifi/esp/hifi_board_lite.h",
     "find": "#define PIN_AMP_SDZ 21",
     "replace": "#define PIN_AMP_SDZ 12"
    },
    {
     "file": "boards/lite-main/kicad/lite-main.net",
     "find": "\"IO21_33\"",
     "replace": "\"SWAP\""
    },
    {
     "file": "boards/lite-main/kicad/lite-main.net",
     "find": "\"IO12_14\"",
     "replace": "\"IO21_33\""
    },
    {
     "file": "boards/lite-main/kicad/lite-main.net",
     "find": "\"SWAP\"",
     "replace": "\"IO12_14\""
    }
   ]
  },
  {
   "id": "vbus-on-adc2",
   "expect": "ADC2-WIFI",
   "about": "VBUS sense moved to GPIO15 (ADC2) on board and firmware alike, with Wi-Fi on",
   "edits": [
    {
     "file": "firmware/components/hifi/esp/hifi_board_lite.h",
     "find": "ADC1_CHANNEL_6 /* GPIO34",
     "replace": "ADC2_CHANNEL_3 /* GPIO15"
    },
    {
     "file": "boards/lite-main/kicad/lite-main.net",
     "find": "\"IO34_6\"",
     "replace": "\"SWAP\""
    },
    {
     "file": "boards/lite-main/kicad/lite-main.net",
     "find": "\"IO15_23\"",
     "replace": "\"IO34_6\""
    },
    {
     "file": "boards/lite-main/kicad/lite-main.net",
     "find": "\"SWAP\"",
     "replace": "\"IO15_23\""
    }
   ]
  },
  {
   "id": "button-volup-on-play",
   "expect": "PIN-SHARED",
   "about": "the volume-up button on GPIO19, the play button's",
   "edits": [
    {
     "file": "firmware/patches/0001-hifi-receiver-hooks.patch",
