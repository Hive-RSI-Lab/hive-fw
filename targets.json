{
  "hifi-lite": {
    "project": "hifi-receiver-2",
    "path": "firmware",
    "about": "The hifi receiver's Lite firmware: squeezelite-esp32 ee1720c plus the receiver's patch and components/hifi, on the ESP32-WROVER-E (8 MB flash, PSRAM). Its own fw.json, when it has one, wins over these pins.",
    "pins": {
      "idf": "v4.4.8",
      "target": "esp32",
      "host_tests": "test",
      "pinmap": {"board": ["../boards/lite-main/kicad/lite-main.kicad_sch", "../boards/lite-main/kicad/lite-main.kicad_pcb"],
                 "sources": ["components/hifi/esp/hifi_board.h", "patches/*.patch"]},
      "prepare": "sh tools/fetch.sh {src}",
      "python": ["setuptools<70", "protobuf>=3.20,<4", "grpcio-tools>=1.48,<1.49"],
      "qemu": {"psram": "4M", "flash": "8MB", "timeout": 120, "settle": 10,
               "expect": "hifi: hifi-lite on \\S+, firmware",
               "sdkconfig": ["CONFIG_ESP32_REV_MIN_0=y", "CONFIG_ESP32_REV_MIN=0",
                             "# CONFIG_ESPTOOLPY_FLASHMODE_QIO is not set", "CONFIG_ESPTOOLPY_FLASHMODE_DIO=y"]}
    }
  }
}
